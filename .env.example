# Optional writable temporary directory for session share links.
# Default: operating-system temp/pocket-photo-booth-shares
# All Node server processes must use the same shared filesystem directory.
# Do not set this to a function-local /tmp directory on Vercel/serverless.
# BOOTH_SHARE_DIR=/var/tmp/pocket-photo-booth-shares

# Cloudflare R2: recommended for Vercel and multiple server instances.
# Copy to .env.local and fill the endpoint, bucket, and both keys.
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Alternatively, supply R2_ACCOUNT_ID instead of R2_ENDPOINT.
# R2_ACCOUNT_ID=

# Optional: force the local temporary server cache (e.g. automated tests).
# BOOTH_SHARE_STORAGE=local
